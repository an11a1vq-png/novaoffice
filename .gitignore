data/sheets/*
!data/sheets/.gitkeep
data/slides/*
!data/slides/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# Logs & temporary files
*.log
*.tmp

# Environment & IDE
.venv/
venv/
env/
.idea/
.vscode/
.DS_Store
